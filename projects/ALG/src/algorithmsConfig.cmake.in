# algorithms Library Config File

# CMake configuration
@PACKAGE_INIT@

# Resolve the imported target referenced by libraries built with OpenMP.
if(@MORIS_USE_OPENMP@)
    include(CMakeFindDependencyMacro)
    find_dependency(OpenMP COMPONENTS CXX)
endif()

# Set *_INCLUDE_DIR
set_and_check(@ALGORITHMS@_INCLUDE_DIR @PACKAGE_LIB_INSTALL_DIR@)

# Create library target
include(@ALGORITHMS@Targets.cmake)
